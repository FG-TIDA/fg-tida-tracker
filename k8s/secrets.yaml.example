# Reference only. FG-TIDA production uses deploy/ and private mounted secrets.
# Generate the actual Kubernetes Secret through your host secret manager.
# Never put credential values, private keys or live user identities in Git.
apiVersion: v1
kind: Secret
metadata:
  name: secrets-env
type: Opaque
stringData:
  FGTIDA_ENV: production
# Required credentials are intentionally omitted so incomplete deployments fail closed.
