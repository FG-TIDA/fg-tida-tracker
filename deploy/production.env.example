# Copy to production.env; do not put credentials in this file.
FGTIDA_ENV=production
FGTIDA_ORIGIN=https://tracker.example.org
# Exact TLS proxy address/CIDR as seen by the nginx container; replace for your host.
FGTIDA_TRUSTED_PROXY_CIDR=replace-with-trusted-proxy-address/32
FGTIDA_APPROVED_PRIVILEGED_USERS=admin-example
FGTIDA_SECRET_KEY_FILE=/run/secrets/django_key
FGTIDA_DB_HOST=db
FGTIDA_DB_PORT=5432
FGTIDA_DB_NAME=fgtida
FGTIDA_DB_USER=fgtida
FGTIDA_DB_PASSWORD_FILE=/run/secrets/db_password
# For the private local Docker network only. Remote databases require verify-full.
FGTIDA_DB_SSLMODE=disable
FGTIDA_SMTP_HOST=smtp.example.org
FGTIDA_MAIL_ENABLED=false
FGTIDA_SMTP_PORT=587
FGTIDA_SMTP_USER=replace-with-authorized-smtp-user
FGTIDA_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
FGTIDA_FROM_EMAIL=FG-TIDA Secretariat <tsbfgtida@itu.int>
FGTIDA_DATA_DIR=/data
FGTIDA_CELERY_BROKER_URL=redis://queue:6379/0
MEMCACHED_SERVICE_HOST=cache
