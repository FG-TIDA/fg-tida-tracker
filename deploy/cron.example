# Operator template: replace /srv/fgtida with the installed repository path.
# Enable outbox delivery only after ITU SMTP approval and controlled mailbox tests.
# Use the SMTP overlay for commands when FGTIDA_MAIL_ENABLED=true.
# Uncomment after SMTP approval:
# * * * * * cd /srv/fgtida && docker compose -f deploy/compose.yml -f deploy/compose.smtp.yml run --rm --no-deps app python ietf/manage.py deliver_fgtida_mail
# Before SMTP activation, the daily job needs only the base Compose file.
# Add '-f deploy/compose.smtp.yml' here too once mail is enabled.
15 3 * * * cd /srv/fgtida && docker compose -f deploy/compose.yml run --rm --no-deps app python ietf/manage.py prune_authentication_attempts
