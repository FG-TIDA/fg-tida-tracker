# Files to be excluded from the docker build context

/.git
/.github
/svn-history
/data
/tmp-*
/dev/security-private
/deploy/secrets
/deploy/production.env
/node_modules
/legacy-tida-backup.json
/ietf/settings_local.py
/ietf/settings_postgresqldb.py
**/settings_local*.py*
**/settings_postgresqldb*.py*
**/.env
**/.env.*
/.local-django-key
**/*.dump
**/*.backup
**/*.key
/ietf/static/dist
/ietf/static/dist-neue
/ietf/secr/static/dist
**/__pycache__
